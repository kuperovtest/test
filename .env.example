# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+85293181485

# Groq API key (free: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key

# AI settings
AI_MODEL=llama-3.3-70b-versatile
AI_SYSTEM_PROMPT=You are a helpful assistant. Reply concisely in the same language as the user's message.
AI_MAX_TOKENS=1024

# Bot settings
# Prefix to trigger AI responses (e.g., ".ai hello" or leave empty to respond to all)
BOT_PREFIX=.ai
# Reply to all incoming private messages automatically (true/false)
AUTO_REPLY=false
