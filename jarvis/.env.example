# Optional: Groq API key for AI-powered natural language understanding
# Without it, Jarvis uses built-in command parsing
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# AI model to use (default: llama-3.3-70b-versatile)
AI_MODEL=llama-3.3-70b-versatile

# Web server settings
JARVIS_HOST=0.0.0.0
JARVIS_PORT=5000

# Security: restrict command execution (comma-separated list of blocked commands)
BLOCKED_COMMANDS=rm -rf /,mkfs,dd if=,:(){ :|:& };:
